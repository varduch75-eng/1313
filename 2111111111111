local function isAnticheatCalling()
    if not _getcallingscript then
        return false
    end
    
    local success, caller = pcall(_getcallingscript)
    
    if not success or not caller then
        return false
    end
    
    local name = caller.Name:lower()
    local path = caller:GetFullName():lower()
    
    -- Проверяем имя и путь
    if name:find("5882957") or
       name:find("inventory") or
       name:find("security") or
       name:find("anticheat") or
       name:find("anti") or
       path:find("security") or
       path:find("shared") or
       path:find("controller") then
        return true
    end
    
    return false
end

